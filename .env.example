# GEMINI_API_KEY: Required for Gemini AI multimodal synthesis, web grounding, and AI Investigation Assistant.
# AI Studio injects this at runtime from user secrets; never expose it to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL / APP_BASE_URL / QR_BASE_URL: Public base URL where this applet is hosted (used in QR sharing links, emails, and direct links).
APP_URL="MY_APP_URL"
APP_BASE_URL=""
QR_BASE_URL=""

# Strict CORS allowlist (comma-separated origins, optional; same-origin and AI Studio preview frames allowed automatically)
ALLOWED_ORIGINS=""

# Storage & Upload Limits (kept outside public/ and dist/)
DB_PATH="./data/db/truthlens.sqlite"
STORAGE_DIR="./data"
MAX_UPLOAD_MB="15"

# SESSION_SECRET: Required in production (minimum 32 random chars) for session/token HMAC signing.
SESSION_SECRET=""

# Optional Admin Governance (strictly server-side, never expose to browser)
ADMIN_EMAIL=""
ADMIN_BOOTSTRAP_SECRET=""

# Primary Email Delivery via Resend (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TruthLens Alerts <alerts@yourdomain.com>"
RESEND_WEBHOOK_SECRET=""

# Fallback Email Delivery via SMTP (alternative to Resend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TruthLens Alerts <alerts@yourdomain.com>"

# Real SMS Delivery via Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
